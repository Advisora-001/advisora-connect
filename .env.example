# ===========================================
# Advisora Connect — Local Development Template
# Copy to .env.local and fill in your values
# ===========================================

# -------------------------------------------
# Frontend (Next.js) — Required for local dev
# -------------------------------------------
# Your local backend API (Render dev service or local server)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Your local frontend URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------------------------------------------
# Backend (Node/Express) — Only needed if running backend locally
# -------------------------------------------
# MongoDB Atlas connection string (get from MongoDB Atlas dashboard)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/advisora

# Resend API key (get from resend.com dashboard)
# RESEND_API_KEY=re_xxxxxxxxxxxxx

# JWT Secret for auth tokens (generate: openssl rand -base64 32)
# JWT_SECRET=your-super-secret-jwt-key-here

# Node environment
# NODE_ENV=development

# Frontend URL for CORS (your local Next.js)
# FRONTEND_URL=http://localhost:3000

# -------------------------------------------
# Optional: Payment / Third-party (add when needed)
# -------------------------------------------
# PAYSTACK_SECRET_KEY=sk_test_xxxxx
# PAYSTACK_PUBLIC_KEY=pk_test_xxxxx
# STRIPE_SECRET_KEY=sk_test_xxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# -------------------------------------------
# Notes:
# -------------------------------------------
# - Production secrets live in Render (backend) and Vercel (frontend)
# - Never commit .env.local or real secrets to git
# - For local backend dev: uncomment MONGODB_URI, RESEND_API_KEY, JWT_SECRET
# - For frontend-only dev: only NEXT_PUBLIC_API_URL and NEXT_PUBLIC_APP_URL needed